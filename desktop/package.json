{
  "name": "ludo-desktop",
  "private": true,
  "version": "1.0.0-beta.7",
  "type": "module",
  "description": "Desktop client \u2014 Access your RomM library and sync your saves and states between RomM and RetroArch",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "npm run build && node electron/launch.cjs",
    "electron:dev": "node electron/launch.cjs --dev",
    "prepare-runtime": "bash tools/prepare-runtime.sh",
    "dist": "npm run build && npm run prepare-runtime && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "io.github.covin90.ludo",
    "productName": "Ludo",
    "artifactName": "Ludo-v${version}-x86_64.AppImage",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "runtime/app-src",
        "to": "app-src"
      },
      {
        "from": "../assets/icons/romm_icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "icon": "../assets/icons/romm_icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "synopsis": "Sync ROMs, saves and states between RomM and RetroArch"
    }
  },
  "author": "Hector Eduardo \"Covin\" Silveri",
  "license": "GPL-3.0"
}
